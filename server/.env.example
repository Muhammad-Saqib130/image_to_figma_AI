# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000

# Your AI provider API key (paste it after the = sign, no quotes or spaces)
AI_API_KEY=

# Optional: Gemini model to use (default: gemini-2.5-flash)
# AI_MODEL=gemini-2.5-pro

# Optional: if the main model is still overloaded (HTTP 503) after 4 retries,
# or its quota is used up (e.g. the free tier's daily limit), this model is
# tried once instead. Each model has its own quota. Leave empty to disable.
GEMINI_FALLBACK_MODEL=
